# Required: API key for OpenAI or your OpenAI-compatible model provider.
LLM_API_KEY=your-model-api-key

# Optional: OpenAI-compatible API endpoint.
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: model exposed by the configured endpoint.
OPENAI_MODEL=gpt-4

# Required: API key used by the Tavily web-search tool.
TAVILY_API_KEY=your-tavily-api-key

# Optional: DEBUG, INFO, WARN, or ERROR.
LOG_LEVEL=INFO

# Optional: comma-separated list of directories the file tools may access.
# Defaults to the current working directory.
WORKSPACE_ROOT=$PWD
